#!/usr/bin/env bash
# =============================================================================
# omarchy-container-welcome — first thing a VNC user sees
# =============================================================================
# Opened by /etc/omarchy-container/autostart.sh in a terminal inside the
# session. Prints what this container is, which compositor actually started and
# why, then hands over an interactive shell. Never exits on its own — closing
# the terminal is the user's call.
# =============================================================================
set -uo pipefail

b() { printf '\033[1m%s\033[0m\n' "$*"; }
d() { printf '\033[2m%s\033[0m\n' "$*"; }

printf '\n'
b "  Omarchy 4.0.1 — containerised desktop"
printf '\n'

case "${XDG_CURRENT_DESKTOP:-unknown}" in
  Hyprland)
    printf '  compositor : Hyprland %s\n' "$(Hyprland --version 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
    d '               real Omarchy compositor, on a host DRM node'
    ;;
  sway|labwc|cage)
    printf '  compositor : %s (wlroots, pixman/CPU renderer)\n' "${XDG_CURRENT_DESKTOP}"
    d '               FALLBACK. Hyprland cannot start on this host: aquamarine'
    d '               0.14.0 needs a GBM-capable DRM node and the headless'
    d '               backend reports drmFD() == -1, so CBackend::start() fails'
    d '               with "no allocator available". Give the container'
    d '               --device /dev/dri --group-add video (modprobe vkms on the'
    d '               host if there is no GPU) and Hyprland runs instead.'
    ;;
  *)
    printf '  compositor : %s\n' "${XDG_CURRENT_DESKTOP:-unknown}"
    ;;
esac

printf '  display    : %s on %s\n' "${WAYLAND_DISPLAY:-?}" "$(hostname 2>/dev/null)"
printf '  rendering  : software (llvmpipe) — there is no GPU here\n'
printf '\n'
b '  keys'
d '    Super+Return / Alt+Return   terminal'
d '    Super+Q      / Alt+Q        close window'
d '    Super+B                     browser      Super+E   files'
d '    Super+1..5   / Alt+1..3     workspaces'
d '    Super+Shift+M               end the session (stops the container)'
printf '\n'
b '  notes'
d '    * Chromium, kdenlive and OBS run, but on a CPU rasteriser. Be patient.'
d '    * pacman and yay work; /etc/pacman.conf carries DisableSandbox because'
d '      the alpm sandbox needs Landlock, which this kernel does not offer.'
d '    * `pacman -Dk` reports 6 missing deps (limine, snapper, sddm, plymouth).'
d '      That is deliberate: they were --assume-installed at build time because'
d '      a container has no bootloader, no btrfs and no display manager.'
d '    * Supervisor logs: /run/user/1000/omarchy-container/log/*.log'
printf '\n'

command -v fastfetch >/dev/null 2>&1 && fastfetch --logo none 2>/dev/null

cd "${HOME:-/home/omarchy}" || cd /
exec "${SHELL:-/bin/bash}" -l
