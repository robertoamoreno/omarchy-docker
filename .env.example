# Copy to .env and edit. docker-compose.yml and the Makefile both read this.

# Size of the headless output the compositor creates and wayvnc captures.
#OMARCHY_RESOLUTION=1920x1080

# Published ports. Both bind to OMARCHY_BIND_ADDR below.
#OMARCHY_VNC_PORT=5900
#OMARCHY_NOVNC_PORT=6080

# 127.0.0.1 keeps the desktop off your network. There is NO authentication by
# default, so only set 0.0.0.0 if you also set OMARCHY_VNC_PASSWORD.
#OMARCHY_BIND_ADDR=127.0.0.1

# Empty = no authentication. When set, the entrypoint generates an RSA key for
# wayvnc automatically (it cannot do password auth without key material).
# Your client must speak RSA-AES: noVNC does, some native clients do not.
#OMARCHY_VNC_PASSWORD=
#OMARCHY_VNC_USERNAME=omarchy

# auto | hyprland | sway. 'auto' probes for a DRM-backed EGL device and picks
# Hyprland only if one exists; otherwise sway. See README > Which compositor.
#OMARCHY_COMPOSITOR=auto

# Start quickshell (Omarchy's bar/menu and the `omarchy` CLI's IPC endpoint).
#OMARCHY_SHELL=1

#OMARCHY_ENABLE_NOVNC=1
#OMARCHY_DEBUG=0
